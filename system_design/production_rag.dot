// Production-grade RAG — reference system design
// (target architecture; architecture.dot shows what this repo implements today)
// Render: dot -Tsvg production_rag.dot -o production_rag.svg && dot -Tpng -Gdpi=130 production_rag.dot -o production_rag.png
//
// Tags inside nodes:  [H#] = hallucination-mitigation control   [S#] = security / privacy control
// Both are expanded in README.md §6.
digraph ProductionRAG {
  graph [rankdir=TB, fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.55, newrank=true,
         label=<<b>Production RAG — Reference System Design</b><br/><font point-size="13">ingestion · serving · guardrails · hallucination mitigation · security · evaluation · observability</font>>,
         labelloc=t, fontsize=22, pad=0.4, compound=true];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#555555", margin="0.12,0.06"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555"];

  // =====================================================================
  // OFFLINE / ASYNC — INGESTION & INDEXING
  // =====================================================================
  subgraph cluster_ingest {
    label="OFFLINE / ASYNC — Ingestion & indexing pipeline (event-driven, idempotent, versioned)";
    style="rounded,filled"; fillcolor="#eef5ff"; color="#7aa7e0"; fontsize=13;

    sources [shape=folder, fillcolor="#fff7e0", label=<<b>Data sources</b><br/>S3 / GCS · SharePoint · Confluence<br/>Google Drive · Postgres · Zendesk · web<br/><font color="#1f5fa8">[S1] source ACLs captured</font>>];
    connect [label=<<b>Connectors</b><br/>full sync + CDC / webhooks<br/>incremental by etag / updated_at<br/>tombstones for deletes<br/><font color="#1f5fa8">[S2] scoped read-only creds</font>>];
    queue   [shape=cds, fillcolor="#f4f4f4", label=<<b>Job queue</b><br/>Kafka / SQS<br/>retries + DLQ<br/>back-pressure>];
    parse   [label=<<b>Parse &amp; extract</b><br/>PDF / HTML / DOCX / PPTX<br/>layout-aware · tables · OCR<br/>quality score · drop junk pages>];
    sanit   [fillcolor="#eaf1fb", label=<<b>Security scan &amp; sanitize</b><br/><font color="#1f5fa8">[S3] malware / file-type check<br/>[S4] PII / secrets detect → redact / tag<br/>[S5] strip hidden text, injected<br/>instructions in docs (indirect PI)</font>>];
    dedup   [label=<<b>Normalize &amp; dedupe</b><br/>exact hash + MinHash near-dup<br/>doc versioning · language detect<br/><font color="#b03a2e">[H1] keep only latest version</font>>];
    chunk   [label=<<b>Chunking</b><br/>structure-aware (headings, tables)<br/>size by doc type · overlap<br/>parent–child (small-to-big)<br/>contextual header per chunk>];
    enrich  [label=<<b>Metadata enrichment</b><br/>tenant_id · acl_groups · source_uri<br/>doc_version · effective_date · page<br/>classification label · lang<br/><font color="#b03a2e">[H2] provenance for citations</font>>];
    embed   [label=<<b>Embedding workers</b><br/>batched · rate-limited · retried<br/>model + version pinned in metadata<br/>sparse vectors / BM25 terms too>];
    indexer [label=<<b>Indexer</b><br/>upsert by stable chunk id<br/>delete propagation (GDPR)<br/>blue/green index versions + alias swap>];

    sources -> connect -> queue -> parse -> sanit -> dedup;
    dedup -> chunk -> enrich -> embed -> indexer;
    {rank=same; sources; connect; queue; parse; sanit; dedup;}
    {rank=same; chunk; enrich; embed; indexer;}
  }

  // =====================================================================
  // DATA LAYER
  // =====================================================================
  subgraph cluster_data {
    label="DATA LAYER — encrypted at rest (KMS), tenant-partitioned, backed up";
    style="rounded,filled"; fillcolor="#eefaf0"; color="#6cbf7f"; fontsize=13;

    rawstore [shape=cylinder, fillcolor="#d9f2df", label=<<b>Object store</b><br/>raw + parsed docs<br/>versioned · retention policy>];
    vecdb    [shape=cylinder, fillcolor="#d9f2df", label=<<b>Vector DB</b><br/>pgvector / Qdrant / Pinecone<br/>HNSW · namespace per tenant<br/>ACL metadata filters>];
    kwidx    [shape=cylinder, fillcolor="#d9f2df", label=<<b>Keyword index</b><br/>OpenSearch / Elastic BM25<br/>same chunk ids + ACL fields>];
    metadb   [shape=cylinder, fillcolor="#d9f2df", label=<<b>Metadata / doc registry</b><br/>Postgres<br/>doc → chunks · versions<br/>sync state · lineage>];
    cache    [shape=cylinder, fillcolor="#d9f2df", label=<<b>Caches</b><br/>Redis<br/>semantic answer cache<br/>(keyed by tenant + ACL hash)<br/>embedding cache>];
    session  [shape=cylinder, fillcolor="#d9f2df", label=<<b>Conversation store</b><br/>chat history · TTL<br/>per-user isolation>];
    {rank=same; rawstore; vecdb; kwidx; metadb; cache; session;}
  }

  // =====================================================================
  // ONLINE — SERVING PATH
  // =====================================================================
  subgraph cluster_online {
    label="ONLINE — Query serving path (stateless, autoscaled, streamed)";
    style="rounded,filled"; fillcolor="#f5f0ff"; color="#a58be0"; fontsize=13;

    // ---- edge ----
    subgraph cluster_edge {
      label="① Edge & access"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      client  [shape=oval, fillcolor="#fff7e0", label=<<b>Clients</b><br/>web / mobile / Slack / API SDK>];
      waf     [fillcolor="#eaf1fb", label=<<b>CDN + WAF</b><br/><font color="#1f5fa8">[S6] TLS 1.3 · DDoS · bot filter</font>>];
      gateway [fillcolor="#eaf1fb", label=<<b>API gateway</b><br/><font color="#1f5fa8">[S7] OIDC / JWT authN<br/>[S8] rate limit · token quotas<br/>per user / tenant · request size cap</font>>];
      client -> waf -> gateway;
      {rank=same; client; waf; gateway;}
    }

    // ---- input guardrails ----
    subgraph cluster_inguard {
      label="② Input guardrails"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      authz   [fillcolor="#eaf1fb", label=<<b>Identity → permissions</b><br/>resolve user groups / tenant<br/><font color="#1f5fa8">[S9] build ACL filter<br/>(never from client input)</font>>];
      inpii   [fillcolor="#eaf1fb", label=<<b>PII / secret scrub</b><br/><font color="#1f5fa8">[S10] mask before LLM + logs</font>>];
      injdet  [fillcolor="#eaf1fb", label=<<b>Prompt-injection &amp;<br/>jailbreak classifier</b><br/><font color="#1f5fa8">[S11] block / flag · policy &amp;<br/>topic moderation<br/>exit: blocked → safe refusal</font>>];
      authz -> inpii -> injdet;
      {rank=same; authz; inpii; injdet;}
    }

    // ---- query understanding ----
    subgraph cluster_qu {
      label="③ Query understanding"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      cachechk [label=<<b>Semantic cache lookup</b><br/>hit (sim ≥ τ, same ACL) → return<br/>cached grounded answer<br/><font color="#6a5acd">exit: cache hit → response</font>>];
      condense [label=<<b>Contextualize</b><br/>condense chat history<br/>into standalone query>];
      router   [label=<<b>Intent router / planner</b><br/>no-retrieval · retrieve · multi-hop<br/>tool / SQL · out-of-scope → refuse<br/><font color="#b03a2e">[H3] refuse out-of-domain early</font><br/><font color="#6a5acd">no-retrieval → skip to ⑤</font>>];
      rewrite  [label=<<b>Query transform</b><br/>rewrite · multi-query<br/>decompose · HyDE<br/>metadata extraction (date, entity)>];
      cachechk -> condense [label="miss"];
      condense -> router -> rewrite;
      {rank=same; cachechk; condense; router; rewrite;}
    }

    // ---- retrieval ----
    subgraph cluster_ret {
      label="④ Retrieval"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      dense   [label=<<b>Dense search</b><br/>query embedding → ANN top-50<br/><font color="#1f5fa8">[S12] ACL + tenant pre-filter</font>>];
      sparse  [label=<<b>Sparse / BM25 search</b><br/>exact terms, IDs, codes top-50<br/><font color="#1f5fa8">[S12] same ACL pre-filter</font>>];
      fuse    [label=<<b>Fusion</b><br/>Reciprocal Rank Fusion<br/>dedupe by chunk / parent>];
      rerank  [label=<<b>Cross-encoder reranker</b><br/>top-50 → top-k (5–10)<br/><font color="#b03a2e">[H4] relevance threshold</font>>];
      ctxbld  [label=<<b>Context builder</b><br/>expand to parent chunk · compress<br/>order (lost-in-middle aware)<br/>token budget · recency / version boost<br/><font color="#b03a2e">[H5] no / low evidence → abstain:<br/>"not found in your documents"</font>>];
      dense -> fuse; sparse -> fuse; fuse -> rerank -> ctxbld;
      {rank=same; dense; sparse; fuse; rerank; ctxbld;}
    dense -> sparse [style=invis];
    }

    // ---- generation ----
    subgraph cluster_gen {
      label="⑤ Generation"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      prompt  [label=<<b>Prompt assembly</b><br/>versioned templates (prompt registry)<br/><font color="#b03a2e">[H6] "answer ONLY from sources,<br/>cite [n], say I don't know"</font><br/><font color="#1f5fa8">[S13] spotlight retrieved text as<br/>untrusted data (delimiters)</font>>];
      llmgw   [label=<<b>LLM gateway</b><br/>model routing (small ↔ large)<br/>timeouts · retries · fallback provider<br/>token budget · cost metering<br/><font color="#1f5fa8">[S14] no-train / zero-retention contract</font>>];
      gen     [label=<<b>Generate</b><br/>low temperature · streaming<br/>structured output (JSON schema)<br/>claims with citation ids<br/><font color="#b03a2e">[H7] constrained, cited output</font>>];
      tools   [fillcolor="#eaf1fb", label=<<b>Tools (optional, agentic)</b><br/>SQL · search · APIs<br/><font color="#1f5fa8">[S15] allow-list · least privilege<br/>human approval for writes</font>>];
      prompt -> gen [weight=10, penwidth=2];
      gen -> llmgw [style=dashed, dir=both, label="LLM call"];
      gen -> tools [style=dashed, dir=both, label="tool calls", weight=10];
      {rank=same; tools; prompt; gen; llmgw;}
    }

    // ---- output guardrails ----
    subgraph cluster_outguard {
      label="⑥ Output guardrails & verification"; style="rounded,filled"; fillcolor="#ffffff"; color="#c9b8f0"; fontsize=11;
      citechk [fillcolor="#fbeaea", label=<<b>Citation validator</b><br/><font color="#b03a2e">[H8] every claim cites a retrieved<br/>chunk · cited ids exist · quotes match</font>>];
      ground  [fillcolor="#fbeaea", label=<<b>Groundedness check</b><br/><font color="#b03a2e">[H9] NLI / LLM-judge per claim<br/>score &lt; τ → regenerate or<br/>drop claim or abstain</font>>];
      outsafe [fillcolor="#eaf1fb", label=<<b>Output safety</b><br/><font color="#1f5fa8">[S16] PII / secret leak scan<br/>moderation · no system-prompt leak<br/>render-safe (no HTML/JS/link exfil)</font>>];
      citechk -> ground -> outsafe;
      {rank=same; citechk; ground; outsafe;}
    }

    resp [shape=oval, fillcolor="#fff7e0", label=<<b>Response (streamed)</b><br/>answer + clickable citations<br/>confidence / "not found" state<br/>👍 / 👎 feedback>];

    // ---- main serving flow ----
    gateway  -> authz    [lhead=cluster_inguard, penwidth=2];
    injdet   -> cachechk [penwidth=2];
    rewrite  -> dense    [penwidth=2];
    rewrite  -> sparse   [penwidth=2];
    ctxbld   -> prompt   [penwidth=2];
    gen      -> citechk  [penwidth=2, weight=0];
    outsafe  -> resp     [penwidth=2];

    // shortcuts

    // corrective loop
    ground -> rewrite [color="#b03a2e", fontcolor="#b03a2e", style=bold, constraint=false,
                       label="[H10] corrective loop: unsupported claim →\nfollow-up retrieval + regenerate (max N=1–2)"];
  }

  // =====================================================================
  // MODEL PROVIDERS
  // =====================================================================
  subgraph cluster_models {
    label="MODEL SERVING — managed API or self-hosted (vLLM / TGI) in VPC";
    style="rounded,filled"; fillcolor="#fdf0f0"; color="#e08a8a"; fontsize=13;
    embmodel  [fillcolor="#fbdede", label=<<b>Embedding model</b><br/>same version for docs + queries>];
    rrmodel   [fillcolor="#fbdede", label=<<b>Reranker model</b><br/>cross-encoder>];
    llmprim   [fillcolor="#fbdede", label=<<b>Primary LLM</b><br/>large model for synthesis>];
    llmsmall  [fillcolor="#fbdede", label=<<b>Small / fast LLM</b><br/>router · rewrite · judge>];
    guardm    [fillcolor="#fbdede", label=<<b>Guard models</b><br/>injection · PII NER · moderation · NLI>];
    {rank=same; embmodel; rrmodel; llmprim; llmsmall; guardm;}
  }

  // =====================================================================
  // CROSS-CUTTING: OBSERVABILITY & EVALUATION
  // =====================================================================
  subgraph cluster_obs {
    label="CROSS-CUTTING — Observability, evaluation & continuous improvement";
    style="rounded,filled"; fillcolor="#fffbe6"; color="#d4b44a"; fontsize=13;
    tracing  [label=<<b>Tracing</b><br/>OpenTelemetry / Langfuse<br/>span per stage · prompt, chunks,<br/>scores, tokens, latency (redacted)>];
    metrics  [label=<<b>Metrics &amp; alerts</b><br/>p50/p95 latency · error rate<br/>cost / query · cache hit rate<br/>abstain rate · groundedness rate>];
    online   [label=<<b>Online eval</b><br/>sampled LLM-judge on prod traffic<br/>faithfulness · answer relevance<br/>user feedback · drift detection>];
    offline  [label=<<b>Offline eval &amp; CI gate</b><br/>golden Q/A set + adversarial set<br/>recall@k · MRR · nDCG · faithfulness<br/>citation accuracy · refusal correctness<br/><font color="#b03a2e">[H11] block deploy on regression</font>>];
    loop     [label=<<b>Feedback loop</b><br/>👎 + low-groundedness traces →<br/>review queue → new eval cases,<br/>chunking / prompt / doc fixes>];
    {rank=same; tracing; metrics; online; offline; loop;}
    tracing -> metrics -> online -> loop;
    offline -> loop [dir=back];
  }

  // =====================================================================
  // CROSS-CUTTING: SECURITY & GOVERNANCE
  // =====================================================================
  subgraph cluster_sec {
    label="CROSS-CUTTING — Security, privacy & governance";
    style="rounded,filled"; fillcolor="#eaf1fb"; color="#5b8bd0"; fontsize=13;
    secrets [label=<<b>Secrets &amp; keys</b><br/>Vault / KMS · rotation<br/>no keys in code or prompts>];
    network [label=<<b>Network</b><br/>private VPC · mTLS between services<br/>egress allow-list (LLM endpoints only)>];
    audit   [label=<<b>Audit log</b><br/>who asked what, which docs were<br/>returned · immutable · SIEM>];
    privacy [label=<<b>Data governance</b><br/>retention / TTL · right-to-delete<br/>data residency · DPA with providers>];
    redteam [label=<<b>Red-team &amp; supply chain</b><br/>prompt-injection test suite<br/>pinned models + deps · SBOM<br/>OWASP LLM Top 10 review>];
    {rank=same; secrets; network; audit; privacy; redteam;}
  }

  // =====================================================================
  // CROSS-CLUSTER EDGES
  // =====================================================================
  // ingestion → stores
  parse   -> rawstore [color="#2e8b57", constraint=false];
  indexer -> vecdb    [color="#2e8b57", penwidth=2];
  indexer -> kwidx    [color="#2e8b57", penwidth=2];
  indexer -> metadb   [color="#2e8b57"];
  indexer -> cache    [color="#2e8b57", style=dashed, label="invalidate on\ndoc change"];

  // serving ↔ stores
  dense    -> vecdb    [color="#2e8b57", dir=both, constraint=false, penwidth=1.5];
  sparse   -> kwidx    [color="#2e8b57", dir=both, constraint=false, penwidth=1.5];
  cachechk -> cache    [color="#2e8b57", dir=both, constraint=false];
  condense -> session  [color="#2e8b57", dir=both, constraint=false];

  // serving → models
  llmgw   -> llmprim  [style=dashed, lhead=cluster_models, penwidth=1.5, label="all model calls go through the gateway\n(embed · rerank · router · judge · guard · generate)"];

  // telemetry
  resp -> tracing [style=dotted, color="#b8a400", label="traces · feedback"];

  // ordering hints (invisible)
  indexer -> rawstore [style=invis];
  gen -> legend [style=invis];
  rawstore -> client  [style=invis];
  tracing -> secrets  [style=invis];

  // =====================================================================
  // LEGEND
  // =====================================================================
  legend [shape=plaintext, fillcolor="none", label=<
    <table border="1" cellborder="0" cellspacing="2" cellpadding="3" bgcolor="#ffffff" color="#999999">
      <tr><td colspan="2"><b>Legend</b></td></tr>
      <tr><td align="left"><b>━━━ bold</b></td><td align="left">main request path</td></tr>
      <tr><td align="left">──── solid</td><td align="left">data / control flow</td></tr>
      <tr><td align="left">- - - dashed</td><td align="left">model call, lookup, or short-circuit exit</td></tr>
      <tr><td align="left"><font color="#2e8b57">━━━ green</font></td><td align="left">data-store I/O</td></tr>
      <tr><td align="left"><font color="#b03a2e">━━━ red bold</font></td><td align="left">corrective (self-check) loop</td></tr>
      <tr><td align="left"><font color="#b8a400">····· dotted</font></td><td align="left">telemetry / audit</td></tr>
      <tr><td align="left"><font color="#b03a2e">[H#]</font></td><td align="left">hallucination-mitigation control</td></tr>
      <tr><td align="left"><font color="#1f5fa8">[S#]</font></td><td align="left">security / privacy control</td></tr>
      <tr><td align="left" bgcolor="#eaf1fb">blue fill</td><td align="left">security component</td></tr>
      <tr><td align="left" bgcolor="#fbeaea">red fill</td><td align="left">verification component</td></tr>
    </table>>];
  {rank=same; legend; redteam;}
}
